server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name app.bacarotruckfoodapp.ovh; # Make sure this matches your domain name

    root /var/www/bacarotruckprivacy/html;

    index index.html index.htm index.nginx-debian.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://localhost:3000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /bacarotruck/privacy/ {
        alias /var/www/bacarotruckprivacy/html;
        try_files $uri $uri/ =404;
        autoindex off;
    }

	
    location /bacarotruck/delete {
        alias /var/www/bacarotruckdelete/html;
        try_files $uri $uri/ =404;
        autoindex off;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/app.bacarotruckfoodapp.ovh/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/app.bacarotruckfoodapp.ovh/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}